{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Vite + React (SPA, SSR, or UI package). Copy to .oxlintrc.json
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.0.0",
      "linkComponents": [{ "name": "Link", "linkAttribute": ["href", "to"] }]
    },
    "jsx-a11y": {
      "components": {
        "Link": "a",
        "Button": "button"
      }
    }
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    "react/no-unescaped-entities": "warn",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    // Vite HMR safety (react-refresh equivalent in oxlint)
    "react/only-export-components": [
      "warn",
      { "allowConstantExport": true }
    ],

    "import/no-anonymous-default-export": "error",
    "import/no-cycle": "error",

    "jsx-a11y/alt-text": "error",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/interactive-supports-focus": "warn",

    "react-perf/jsx-no-new-object-as-prop": "warn",
    "react-perf/jsx-no-new-array-as-prop": "warn",
    "react-perf/jsx-no-new-function-as-prop": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/dev-dist/**",
    "**/*.min.js",
    "**/vite.config.*.timestamp-*"
  ],
  "overrides": [
    {
      "files": [
        "**/*.{test,spec}.{ts,tsx,js,jsx}",
        "**/__tests__/**",
        "**/tests/**"
      ],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off",
        "react/only-export-components": "off",
        "react-perf/jsx-no-new-object-as-prop": "off",
        "react-perf/jsx-no-new-array-as-prop": "off",
        "react-perf/jsx-no-new-function-as-prop": "off"
      }
    },
    {
      "files": [
        "vite.config.{ts,mts,js,mjs}",
        "vitest.config.{ts,mts,js,mjs}",
        "**/scripts/**"
      ],
      "env": {
        "node": true
      },
      "rules": {
        "no-console": "off",
        "import/no-anonymous-default-export": "off",
        "react/only-export-components": "off"
      }
    }
  ]
}
